# These are estimates, not verified platform fees. Set them for your account.
AUTOSCOUT_SELL_FEE_RATE=0.03
# Withdrawal fee is charged in addition to the cash principal.
AUTOSCOUT_PAYOUT_FEE_RATE=0.01
AUTOSCOUT_UNDERCUT=0.01
AUTOSCOUT_MIN_PROFIT=0.50
AUTOSCOUT_MIN_ROI=0.05
AUTOSCOUT_MAX_PAGES=2
AUTOSCOUT_MAX_OFFERS=100
AUTOSCOUT_OPERATION_TIMEOUT=30
AUTOSCOUT_RUN_TIMEOUT=900
AUTOSCOUT_AUTO_SCAN=true
AUTOSCOUT_SCAN_INTERVAL=1800
# Comma-separated keywords; blank means a full lowest-price scan.
AUTOSCOUT_SCAN_KEYWORDS=
AUTOSCOUT_BROWSER_CHANNEL=auto
# Override with chrome, msedge, or empty for a specific Playwright Chromium installation.
# AUTOSCOUT_DATA_DIR=C:/Users/you/AppData/Local/AutoSteamScout
# AUTOSCOUT_HEADLESS=true
# Local login debugging only: echo phone/code in the terminal and show them in the live /auth frame.
# AUTOSCOUT_SHOW_LOGIN_INPUT=false
# Optional fixed password for --remote-debug (minimum 16 characters); blank generates a new one at startup.
# AUTOSCOUT_DEBUG_PASSWORD=
# AUTOSCOUT_SONKWO_PROFILE=C:/path/to/your/sonkwo/profile
# AUTOSCOUT_STEAMPY_PROFILE=C:/path/to/your/steampy/profile
